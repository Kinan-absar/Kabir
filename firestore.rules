rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if request.auth != null;
    }

    match /sales/{id} {
      allow read, write: if request.auth != null;
    }
    match /expenses/{id} {
      allow read, write: if request.auth != null;
    }
    match /suppliers/{id} {
      allow read, write: if request.auth != null;
    }
    match /monthly_cash/{id} {
      allow read, write: if request.auth != null;
    }
    match /manual_months/{id} {
      allow read, write: if request.auth != null;
    }
    match /extra_expenses/{id} {
      allow read, write: if request.auth != null;
    }
    match /month_overrides/{id} {
      allow read, write: if request.auth != null;
    }
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }
    match /test/connection {
      allow read: if request.auth != null;
    }
  }
}
